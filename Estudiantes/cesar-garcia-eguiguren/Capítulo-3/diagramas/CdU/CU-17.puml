@startuml CU-17
skinparam MaxMessageSize 150

title Diagrama de Secuencia de Diseño - CU-17 Guardar Snapshot

actor "Director /\nResponsable" as U
participant "Frontend\n(React)" as FE
participant "API\n(FastAPI)" as API
participant "SnapshotService" as SVC
participant "SnapshotRepository" as REPO
database "MongoDB" as DB

U -> FE : Click "Guardar Snapshot"\nen una vista calculada
activate FE

FE -> API : POST /snapshots/metrics\nBody: {metric_name, params, data}\n(JWT Bearer)
activate API

API -> API : require_manager_or_above(cu)\n→ 403 si rol = empleado

note right of API
  También aplica para:
  POST /snapshots/charts
  POST /snapshots/entities
end note

API -> SVC : save_metric(cu, metric_name,\nparams, data)
activate SVC

SVC -> SVC : Crea actor dict desde cu:\n{user_id, employee_id,\nemployee_name, role}

SVC -> REPO : upsert_metric_snapshot(\nmetric_name, params, data, actor)
activate REPO

REPO -> REPO : params_hash = SHA-256(params)[:16]
REPO -> REPO : snap_date = today (YYYY-MM-DD)
REPO -> REPO : match = {metric_name,\nparams_hash, snapshot_date}

REPO -> DB : coll.update_one(\n  filter=match,\n  update={\n    $set: {data, updated_at, updated_by},\n    $setOnInsert: {created_at, created_by}\n  },\n  upsert=True\n)
activate DB
DB --> REPO : UpdateResult
deactivate DB

alt upserted_id is not None (documento nuevo)

REPO --> SVC : {id: upserted_id,\ncreated: True, snapshot_date}

else Documento ya existía (actualizado)

REPO -> DB : coll.find_one(match)
activate DB
DB --> REPO : documento con _id
deactivate DB

REPO --> SVC : {id: _id,\ncreated: False, snapshot_date}

end
deactivate REPO

SVC --> API : {id, created, snapshot_date}
deactivate SVC

alt created == True

API --> FE : 201 Created\n{id, created, snapshot_date}

else created == False

API --> FE : 200 OK\n{id, created, snapshot_date}

end
deactivate API

alt Snapshot nuevo

FE --> U : Notificación: "Guardado"

else Snapshot actualizado

FE --> U : Notificación: "Actualizado\n(ya existía hoy)"

end
deactivate FE

@enduml