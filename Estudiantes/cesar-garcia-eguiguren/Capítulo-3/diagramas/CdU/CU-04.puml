@startuml CU-04
skinparam MaxMessageSize 150

title Diagrama de Secuencia de Diseño - CU-04 Listar Departamentos

actor "Responsable /\nDirector" as User
participant "Frontend\n(React)" as FE
participant "API\n(FastAPI)" as API
participant "DepartmentService" as Service
participant "DepartmentRepository" as Repo
database "PostgreSQL\n(Odoo)" as DB

User -> FE: Navega a la vista de Departamentos
activate FE

FE -> API: GET /departments/?search&sort_by&sort_order&page&page_size\n(JWT Bearer)
activate API

API -> API : require_manager_or_above(cu)\n→ 403 si rol = empleado

API -> Service: list_departments(cu, search,\nsort_by, sort_order, page, page_size)
activate Service

Service -> Service: Determinar dept_ids:\nsi cu.is_responsable\n→ dept_ids = cu.department_ids\nsi no → None

Service -> Repo: get_filtered_departments_query(db,\ndept_ids, search, sort_by, sort_order)
activate Repo

Repo -> DB: SELECT hr_department\nWHERE active = True\nAND [id IN (:dept_ids)]\nAND [name ILIKE :search]\nORDER BY :sort_by
activate DB
DB --> Repo: query resultante
deactivate DB

Repo --> Service: query
deactivate Repo

Service -> Service: paginate(query, page, page_size)

Service -> Service: Convertir cada fila a DepartmentDetail

Service --> API: PaginatedResponse[DepartmentDetail]
deactivate Service

API --> FE: 200 OK\nPaginatedResponse[DepartmentDetail]
deactivate API

FE --> User: Muestra lista paginada de departamentos
deactivate FE

@enduml