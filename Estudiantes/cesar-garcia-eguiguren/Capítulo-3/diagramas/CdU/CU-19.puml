@startuml CU-19
skinparam MaxMessageSize 150

title Diagrama de Secuencia de Diseño - CU-19 Consultar Detalle de Snapshot

actor "Director /\nResponsable" as U
participant "Frontend 2\n(Visor React)" as FE
participant "API\n(FastAPI)" as API
participant "SnapshotService" as SVC
participant "SnapshotRepository" as REPO
database "MongoDB" as DB

== Consultar detalle ==

U -> FE : Selecciona snapshot de la lista\n(procedente de CU-18)
activate FE

FE -> API : GET /snapshots/{type}/{snapshot_id}\n(JWT Bearer)
activate API

API -> API : require_manager_or_above(cu)\n→ 403 si rol = empleado

note right of API
  type: metrics | charts | entities
end note

API -> SVC : get_metric(snapshot_id)
activate SVC

SVC -> REPO : get_metric_snapshot(id_str)
activate REPO

REPO -> DB : coll.find_one(\n  {_id: ObjectId(id)}\n)
activate DB
DB --> REPO : documento o null
deactivate DB

alt Documento encontrado

REPO -> REPO : Serializa (_id -> string id)
REPO --> SVC : snapshot document
deactivate REPO

SVC --> API : snapshot data
deactivate SVC

API --> FE : 200 OK (JSON)
deactivate API

FE -> FE : Determina renderer según type:\nMetricView / ChartView / EntityView

FE --> U : Muestra vista reconstruida\ndesde los datos del snapshot
deactivate FE

else Documento no encontrado

REPO --> SVC : null
deactivate REPO

SVC -> SVC : raise HTTPException(404,\n"Snapshot no encontrada")

SVC --> API : HTTPException 404
deactivate SVC

API --> FE : 404 Not Found
deactivate API

FE --> U : Muestra mensaje de error
deactivate FE

end

== Opcional: Eliminar snapshot ==

opt El usuario pulsa "Eliminar"

U -> FE : Click "Eliminar"
activate FE

FE -> API : DELETE /snapshots/{type}/{snapshot_id}\n(JWT Bearer)
activate API

API -> API : require_manager_or_above(cu)\n→ 403 si rol = empleado

API -> SVC : delete_metric(snapshot_id)
activate SVC

SVC -> REPO : delete_metric_snapshot(id_str)
activate REPO

REPO -> DB : coll.delete_one(\n  {_id: ObjectId(id)}\n)
activate DB
DB --> REPO : DeleteResult
deactivate DB

alt deleted_count == 1

    REPO --> SVC : True
    deactivate REPO

    SVC --> API : {deleted: True, id}
    deactivate SVC

    API --> FE : 200 OK
    deactivate API

    FE --> U : Notificación: "Snapshot eliminada"
    deactivate FE

else deleted_count == 0

    REPO --> SVC : False
    deactivate REPO

    SVC -> SVC : raise HTTPException(404,\n"Snapshot no encontrada")

    SVC --> API : HTTPException 404
    deactivate SVC

    API --> FE : 404 Not Found
    deactivate API

    FE --> U : Muestra mensaje de error
    deactivate FE

end

end

@enduml
