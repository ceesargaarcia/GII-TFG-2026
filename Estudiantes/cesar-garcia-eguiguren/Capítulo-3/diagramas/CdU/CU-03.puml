@startuml CU-03
skinparam MaxMessageSize 150

title Diagrama de Secuencia de Diseño - CU-03 Consultar Ficha del Empleado

actor "Responsable /\nDirector" as User
participant "Frontend\n(React)" as FE
participant "API\n(FastAPI)" as API
participant "DashboardService" as DashService
participant "WorkloadService" as WLService
participant "WIPService" as WIPService
participant "ProductivityService" as ProdService
participant "Capa de Acceso a Datos" as DB

== Paso 2: Dashboard del empleado ==

FE -> API: GET /dashboards/summary/employee/{employee_id}\n(JWT Bearer)
activate API

API -> API : require_manager_or_above(cu)\n→ 403 si rol = empleado

API -> DashService: get_employee_summary(cu, employee_id)
activate DashService

DashService -> DashService: verify_employee_exists +\nverify_employee_scope

DashService -> WLService: calculate(employee_id, detailed=True)
activate WLService
WLService -> DB: get_user_id_for_employee(db, employee_id)
activate DB
DB --> WLService: user_id
deactivate DB
WLService -> DB: get_assigned_open_tasks(db, user_id)
activate DB
DB --> WLService: tareas abiertas
deactivate DB
WLService -> DB: get_assigned_closed_tasks(db, user_id,\ndate_from=cutoff)
activate DB
DB --> WLService: tareas cerradas
deactivate DB
WLService --> DashService: WorkloadResult
deactivate WLService

DashService -> WIPService: calculate(employee_id)
activate WIPService
WIPService -> DB: get_user_id_for_employee(db, employee_id)
activate DB
DB --> WIPService: user_id
deactivate DB
WIPService -> DB: count_open_assigned_tasks(db, user_id)
activate DB
DB --> WIPService: wip_count
deactivate DB
WIPService --> DashService: WIPResult
deactivate WIPService

DashService -> ProdService: calculate(employee_id,\ndate_from, date_to)
activate ProdService
ProdService -> DB: get_completed_tasks_with_hours(db,\nemployee_id, ...)
activate DB
DB --> ProdService: tareas completadas con horas
deactivate DB
ProdService --> DashService: ProductivityResult
deactivate ProdService

DashService --> API: EmployeeSummaryResponse
deactivate DashService

API --> FE: 200 OK - EmployeeSummaryResponse
deactivate API

FE --> User: Muestra dashboard con métricas\n(Workload, WIP, Productividad)


@enduml