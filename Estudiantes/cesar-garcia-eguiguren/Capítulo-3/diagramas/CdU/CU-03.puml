@startuml CU-03
skinparam MaxMessageSize 150

title Diagrama de Secuencia de Diseño - CU-03 Consultar Ficha del Empleado

actor "Responsable /\nDirector" as User
participant "Frontend\n(React)" as FE
participant "API\n(FastAPI)" as API
participant "EmployeeService" as EmpService
participant "EmployeeRepository" as EmpRepo
participant "DashboardService" as DashService
participant "WorkloadService" as WLService
participant "WIPService" as WIPService
participant "ProductivityService" as ProdService
participant "TaskService" as TaskService
participant "TaskRepository" as TaskRepo
participant "TimesheetRepository" as TSRepo
database "PostgreSQL\n(Odoo)" as DB

== Paso 1: Ficha del empleado ==

User -> FE: Selecciona un empleado de la lista
activate FE

FE -> API: GET /employees/{employee_id}\n(JWT Bearer)
activate API

API -> API : require_manager_or_above(cu)\n→ 403 si rol = empleado

API -> EmpService: get_employee(cu, employee_id)
activate EmpService

EmpService -> EmpService: verify_employee_exists(db, employee_id)\n(utils/validation)

alt Empleado no encontrado
    EmpService --> API: 404 Not Found
    API --> FE: 404 Not Found
    FE --> User: Muestra mensaje de error
end

EmpService -> EmpService: verify_employee_scope(cu, employee_id)\n(utils/validation)

alt Sin acceso al empleado
    EmpService --> API: 403 Forbidden
    API --> FE: 403 Forbidden
    FE --> User: Muestra mensaje de error
end

EmpService -> EmpRepo: get_employee_by_id(db, employee_id)
activate EmpRepo
EmpRepo -> DB: SELECT hr_employee\nJOIN hr_department\nWHERE id = :employee_id
activate DB
DB --> EmpRepo: datos completos del empleado
deactivate DB
EmpRepo --> EmpService: EmployeeDetail
deactivate EmpRepo

EmpService --> API: EmployeeDetail
deactivate EmpService

API --> FE: 200 OK - EmployeeDetail
deactivate API

FE --> User: Muestra ficha del empleado

== Paso 2: Dashboard del empleado ==

FE -> API: GET /dashboards/summary/employee/{employee_id}\n(JWT Bearer)
activate API

API -> API : require_manager_or_above(cu)\n→ 403 si rol = empleado

API -> DashService: get_employee_summary(cu, employee_id)
activate DashService

DashService -> DashService: verify_employee_exists +\nverify_employee_scope

DashService -> WLService: calculate(employee_id, detailed=True)
activate WLService
WLService -> DB: get_user_id_for_employee(db, employee_id)
activate DB
DB --> WLService: user_id
deactivate DB
WLService -> DB: get_assigned_open_tasks(db, user_id)
activate DB
DB --> WLService: tareas abiertas
deactivate DB
WLService -> DB: get_assigned_closed_tasks(db, user_id,\ndate_from=cutoff)
activate DB
DB --> WLService: tareas cerradas
deactivate DB
WLService --> DashService: WorkloadResult
deactivate WLService

DashService -> WIPService: calculate(employee_id)
activate WIPService
WIPService -> DB: get_user_id_for_employee(db, employee_id)
activate DB
DB --> WIPService: user_id
deactivate DB
WIPService -> DB: count_open_assigned_tasks(db, user_id)
activate DB
DB --> WIPService: wip_count
deactivate DB
WIPService --> DashService: WIPResult
deactivate WIPService

DashService -> ProdService: calculate(employee_id,\ndate_from, date_to)
activate ProdService
ProdService -> DB: get_completed_tasks_with_hours(db,\nemployee_id, ...)
activate DB
DB --> ProdService: tareas completadas con horas
deactivate DB
ProdService --> DashService: ProductivityResult
deactivate ProdService

DashService --> API: EmployeeSummaryResponse
deactivate DashService

API --> FE: 200 OK - EmployeeSummaryResponse
deactivate API

FE --> User: Muestra dashboard con métricas\n(Workload, WIP, Productividad)

== Paso 3: Tareas del empleado ==


    User -> FE: Click en pestaña "Tareas"

    FE -> API: GET /tasks/filter?employee_id={id}\n&status=pending|completed\n(JWT Bearer)
    activate API

    API -> API : require_manager_or_above(cu)\n→ 403 si rol = empleado

    API -> TaskService: filter_tasks(cu, employee_id,\nstatus, ...)
    activate TaskService

    TaskService -> TaskService: verify_employee_exists +\nverify_employee_scope

    TaskService -> TaskRepo: build_filtered_query(db, ...)
    activate TaskRepo
    TaskRepo -> DB: SELECT project_task\nJOIN project_project\nWHERE employee_id = :id\nAND [status filters]
    activate DB
    DB --> TaskRepo: query resultante
    deactivate DB
    TaskRepo --> TaskService: query
    deactivate TaskRepo

    TaskService -> TaskService: paginate(query, page, page_size)

    TaskService -> TSRepo: get_worked_hours_batch(db, task_ids)
    activate TSRepo
    TSRepo -> DB: SELECT SUM(unit_amount)\nFROM account_analytic_line\nGROUP BY task_id
    activate DB
    DB --> TSRepo: hours_map
    deactivate DB
    TSRepo --> TaskService: hours_map
    deactivate TSRepo

    TaskService -> TaskService: _build_items(tasks, status,\nemployee_id, hours_map)

    TaskService --> API: PaginatedResponse[TaskItem]
    deactivate TaskService

    API --> FE: 200 OK\nPaginatedResponse[TaskItem]
    deactivate API

    FE --> User: Muestra lista paginada de tareas

deactivate FE

@enduml