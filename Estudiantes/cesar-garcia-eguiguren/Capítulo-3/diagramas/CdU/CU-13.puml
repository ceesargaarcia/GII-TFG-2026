@startuml CU-13
skinparam MaxMessageSize 150

title Diagrama de Secuencia de Diseño - CU-13 Consultar Rentabilidad Financiera

actor "Director" as U
participant "Frontend\n(React)" as FE
participant "API\n(FastAPI)" as API
participant "RentabilityService" as SVC
participant "RentabilityRepository" as REPO
database "PostgreSQL\n(Odoo)" as DB

== Fase 1: Resumen global ==

U -> FE : Selecciona "Rentabilidad Financiera"
activate FE

FE -> API : GET /metrics/profitability/summary\n?date_from&date_to (JWT Bearer)
activate API

API -> API : require_director(cu)\n→ 403 si rol ≠ director

note right of API
  Solo directores pueden acceder
  a la rentabilidad financiera.
  No hay Capa 2 ni Capa 3:
  el director ve todos los datos.
end note

API -> SVC : get_summary(date_from, date_to)
activate SVC

SVC -> REPO : get_global_totals(db, date_from, date_to)
activate REPO
REPO -> DB : SELECT SUM(CASE income)\n SUM(CASE expense)\n SUM(amount)\n SUM(unit_amount)\nFROM account_analytic_line\nWHERE project_id IS NOT NULL\n AND date BETWEEN :from AND :to
activate DB
DB --> REPO : totales globales
deactivate DB
REPO --> SVC : totales globales
deactivate REPO

SVC -> REPO : get_profitability_by_project(db, date_from, date_to)
activate REPO
REPO -> DB : SELECT project_id,\n SUM(income), SUM(expense),\n SUM(amount), SUM(unit_amount)\nFROM account_analytic_line\nWHERE project_id IS NOT NULL\n AND date BETWEEN :from AND :to\nGROUP BY project_id
activate DB
DB --> REPO : filas por proyecto
deactivate DB
REPO --> SVC : filas por proyecto
deactivate REPO

SVC -> SVC : Cuenta {ganancia, neutro, pérdida}\npor proyecto

SVC --> API : SummaryJSON
deactivate SVC

API --> FE : 200 OK (summary)
deactivate API

FE --> U : Muestra resumen global\n(totales + distribución)
deactivate FE

== Fase 2: Detalle por proyecto ==

U -> FE : Navega a pestaña "Por Proyecto"
activate FE

FE -> API : GET /metrics/profitability/per-project\n?date_from&date_to&project_id&manager_id\n(JWT Bearer)
activate API

API -> SVC : get_per_project(date_from, date_to,\nproject_id, manager_id)
activate SVC

SVC -> REPO : get_profitability_by_project(db,\nproject_id, manager_id, date_from, date_to)
activate REPO
REPO -> DB : SELECT project_id,\n SUM(income), SUM(expense),\n SUM(amount), SUM(unit_amount)\nFROM account_analytic_line\nWHERE [filtros opcionales]\nGROUP BY project_id
activate DB
DB --> REPO : filas agrupadas
deactivate DB
REPO --> SVC : filas agrupadas
deactivate REPO

SVC -> REPO : get_project_meta(db, project_ids)
activate REPO
REPO -> DB : SELECT pp.id, pp.name, rp.name AS manager\nFROM project_project pp\nLEFT JOIN res_partner rp\n ON pp.partner_id = rp.id\nWHERE pp.id IN (:ids)
activate DB
DB --> REPO : metadatos de proyectos
deactivate DB
REPO --> SVC : metadatos de proyectos
deactivate REPO

SVC -> SVC : Construye filas con pct y status\n(ganancia / neutro / pérdida)

SVC --> API : List[ProjectRow]
deactivate SVC

API --> FE : 200 OK (lista de proyectos)
deactivate API

FE --> U : Muestra tabla de rentabilidad\npor proyecto
deactivate FE

== Fase 3 (opcional): Desglose de líneas analíticas ==

opt El usuario pulsa "Ver Detalles" en un proyecto

U -> FE : Click "Ver Detalles" (project_id)
activate FE

FE -> API : GET /metrics/profitability/per-project\n/{project_id}/lines?date_from&date_to\n(JWT Bearer)
activate API

API -> SVC : get_project_lines(project_id,\ndate_from, date_to)
activate SVC

SVC -> REPO : get_account_analytic_lines(db,\nproject_id, date_from, date_to)
activate REPO
REPO -> DB : SELECT id, date, name,\n amount, unit_amount\nFROM account_analytic_line\nWHERE project_id = :pid\n AND date BETWEEN :from AND :to
activate DB
DB --> REPO : líneas analíticas
deactivate DB
REPO --> SVC : líneas analíticas
deactivate REPO

SVC -> SVC : Separa en {incomes, expenses}

SVC --> API : {incomes: [...], expenses: [...]}
deactivate SVC

API --> FE : 200 OK (desglose)
deactivate API

FE --> U : Muestra tabla de ingresos\ny gastos del proyecto
deactivate FE

end

== Opcional: Guardar snapshot (extiende CU-17) ==

opt El usuario pulsa "Guardar Snapshot"

U -> FE : Click "Guardar Snapshot"
activate FE
FE -> FE : Empaqueta datos calculados
note right of FE : Se extiende CU-17\n(Guardar Snapshot)
FE --> U : Confirmación de guardado
deactivate FE

end

@enduml