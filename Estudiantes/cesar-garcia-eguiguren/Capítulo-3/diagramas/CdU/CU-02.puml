@startuml CU-02
skinparam MaxMessageSize 150

title Diagrama de Secuencia de Diseño - CU-02 Listar Empleados

actor "Responsable /\nDirector" as User
participant "Frontend\n(React)" as FE
participant "API\n(FastAPI)" as API
participant "EmployeeService" as Service
participant "EmployeeRepository" as Repo
database "PostgreSQL\n(Odoo)" as DB

User -> FE: Navega a la vista de Empleados
activate FE

FE -> API: GET /employees/?department_id&search&sort_by&page&page_size\n(JWT Bearer)
activate API

API -> API : require_manager_or_above(cu)\n→ 403 si rol = empleado

API -> Service: list_employees(cu, department_id,\nsearch, active, sort_by, sort_order, page, page_size)
activate Service

opt department_id proporcionado
    Service -> Service: verify_department_exists(db, department_id)\n(utils/validation)

    alt Departamento no encontrado
        Service --> API: 404 Not Found
        API --> FE: 404 Not Found
        FE --> User: Muestra mensaje de error
    end

    Service -> Service: verify_department_scope(cu, department_id)\n(utils/validation)

    alt Sin acceso al departamento
        Service --> API: 403 Forbidden
        API --> FE: 403 Forbidden
        FE --> User: Muestra mensaje de error
    end
end

Service -> Service: Determinar emp_ids:\nsi cu.is_responsable y no department_id\n→ emp_ids = cu.employee_ids\nsi no → None

Service -> Repo: get_filtered_employees_query(db,\nemp_ids, department_id, search,\nactive, sort_by, sort_order)
activate Repo

Repo -> DB: SELECT hr_employee\nJOIN hr_department\nWHERE [filters]
activate DB
DB --> Repo: query resultante
deactivate DB

Repo --> Service: query
deactivate Repo

Service -> Service: paginate(query, page, page_size)

Service --> API: PaginatedResponse[EmployeeDetail]
deactivate Service

API --> FE: 200 OK\nPaginatedResponse[EmployeeDetail]
deactivate API

FE --> User: Muestra lista paginada de empleados
deactivate FE

@enduml