@startuml CU-08
skinparam MaxMessageSize 150

title Diagrama de Secuencia de Diseño - CU-08 Consulta de Tareas con Filtros

actor "Responsable /\nDirector" as User
participant "Frontend\n(React)" as FE
participant "API\n(FastAPI)" as API
participant "TaskService" as Service
participant "TaskRepository" as TaskRepo
participant "TimesheetRepository" as TSRepo
database "PostgreSQL\n(Odoo)" as DB

User -> FE: Abre vista de tareas y aplica filtros
activate FE

FE -> API: GET /tasks/filter?status&project_id&employee_id\n&department_id&date_from&date_to&search&page&page_size\n(JWT Bearer)
activate API

API -> API : require_manager_or_above(cu)\n→ 403 si rol = empleado

API -> Service: filter_tasks(cu, status, stage_id,\nproject_id, department_id, date_from,\ndate_to, search, root_only, employee_id,\nresponsable, sort_by, sort_order, page, page_size)
activate Service

alt cu.is_responsable y no employee_id
    Service -> Service: effective_project_ids = cu.project_ids\n(o [project_id] si proporcionado y en alcance)
end

opt project_id proporcionado (Director)
    Service -> Service: verify_project_exists(db, project_id)
end

opt employee_id proporcionado
    Service -> Service: verify_employee_exists(db, employee_id)
    Service -> Service: verify_employee_scope(cu, employee_id)
    alt Empleado no encontrado o sin acceso
        Service --> API: 404 / 403
        API --> FE: Error
        FE --> User: Muestra mensaje de error
    end
end

opt department_id proporcionado
    Service -> Service: verify_department_exists(db, department_id)
    Service -> Service: verify_department_scope(cu, department_id)
    alt Departamento no encontrado o sin acceso
        Service --> API: 404 / 403
        API --> FE: Error
        FE --> User: Muestra mensaje de error
    end
end

Service -> TaskRepo: build_filtered_query(db,\nproject_ids, project_id, stage_id,\nstatus, employee_id, ...)
activate TaskRepo

TaskRepo -> DB: SELECT project_task\nJOIN project_project\nJOIN project_task_type\nWHERE [conditions]
activate DB
DB --> TaskRepo: query resultante
deactivate DB

TaskRepo --> Service: query
deactivate TaskRepo

Service -> Service: paginate(query, page, page_size)

Service -> TSRepo: get_worked_hours_batch(db, task_ids)
activate TSRepo

TSRepo -> DB: SELECT task_id, SUM(unit_amount)\nFROM account_analytic_line\nGROUP BY task_id
activate DB
DB --> TSRepo: hours_map
deactivate DB

TSRepo --> Service: hours_map
deactivate TSRepo

Service -> Service: _build_items(tasks, status,\nemployee_id, hours_map)

Service --> API: PaginatedResponse[TaskItem]
deactivate Service

API --> FE: 200 OK\nPaginatedResponse[TaskItem]
deactivate API

FE --> User: Muestra lista filtrada y paginada de tareas
deactivate FE

@enduml